[Unit]
# Renders homelab/agentic/generated/*.md from the merged architecture data (curated
# facts + live per-host agent syncs) — the inventory a Claude Code session consults
# instead of re-probing the homelab. Distinct from homelab-docs.service, which writes
# a different set of docs for the phone's local LLM assistant.
# Install on opti:
#   sudo cp homelab-agentic-docs.service homelab-agentic-docs.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now homelab-agentic-docs.timer
Description=Homelab agentic docs generator (architecture data -> Markdown for coding agents)
After=network-online.target zfs-mount.service
Wants=network-online.target
Requires=zfs-mount.service

[Service]
ExecStartPre=/usr/bin/mountpoint -q /srv/red
Type=oneshot
User=ptm
ExecStart=/usr/bin/python3 /srv/red/fs/ptm/repo/ptm4/homelab/tools/architecture/gen-agentic-docs.py
