[Unit]
# Durable per-minute host vitals into homelab.db.
#
# The webapp already polls the same /vitals endpoints, but keeps only 6h at 30s plus 48h
# of 5-minute buckets, in memory on the rpi. This keeps 30 days at 60s plus hourly
# rollups forever, on the pool. The two are complementary on purpose: the webapp's rings
# stay canonical for the live board, so the dashboard still works when opti is down.
#
# Install on opti (the deploy workflow does this on push):
#   sudo cp homelab-db-vitals.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now homelab-db-vitals
Description=Homelab DB vitals logger (60s host vitals -> homelab.db)
After=network-online.target zfs-mount.service homelab-db.service
Wants=network-online.target
Requires=zfs-mount.service

[Service]
ExecStartPre=/usr/bin/mountpoint -q /srv/red
Type=simple
User=ptm
EnvironmentFile=-/etc/hl-agents.env
WorkingDirectory=/srv/red/fs/ptm/repo/ptm4/homelab/tools/homelab-db
ExecStart=/usr/bin/python3 /srv/red/fs/ptm/repo/ptm4/homelab/tools/homelab-db/vitals_logger.py
Restart=on-failure
RestartSec=30

ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/srv/red/opsdb
MemoryMax=256M
IPAddressAllow=192.168.1.0/24 127.0.0.0/8
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
