[Unit]
# One homelab collector run (%i = homelab-doctor, network-report, hardware-report, ...).
# Started by hl-collector-frequent@%i.timer / hl-collector-daily@%i.timer. Replaced the
# GitHub Actions cron in homelab-agents.yml on 2026-09-24: GitHub fired ~5 of the 48
# scheduled runs a day, and every run depended on GitHub + PyPI being reachable.
#
# Gated on the webapp's enable switch (ExecCondition — a disabled collector is skipped
# cleanly, not failed). Run-now uses the ungated twin, hl-collector-now@.service.
# A failure pushes a phone notification via hl-notify-failure@.service (ntfy).
#
# Installed + timers enabled by .github/workflows/opti-deploy.yml.
Description=Homelab collector %i
After=network-online.target zfs-mount.service
Wants=network-online.target
Requires=zfs-mount.service
OnFailure=hl-notify-failure@%n.service

[Service]
Type=oneshot
User=ptm
# Full journal read for journald-hunter (ptm is not in systemd-journal, so without this it
# saw ~9% of opti's journal: no kernel or smartd lines). Read-only, scoped to these runs;
# the same mechanism hl-notify-failure@.service uses. rpi/noblenumbat need nothing: ptm is
# in adm there, which the journal ACL already grants read.
SupplementaryGroups=systemd-journal
EnvironmentFile=-/etc/hl-agents.env
ExecCondition=/usr/bin/python3 /srv/red/fs/ptm/repo/ptm4/homelab/hosts/opti/agent-dispatcher.py --is-enabled %i
ExecStartPre=/usr/bin/mountpoint -q /srv/red
ExecStart=/usr/bin/python3 /srv/red/fs/ptm/repo/ptm4/homelab/hosts/opti/agent-dispatcher.py --run %i
# A hung host must not wedge the schedule: systemd kills the run and OnFailure fires.
# (A second start while one is running just waits for it — runs can never overlap.)
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=idle
PrivateTmp=true
MemoryMax=512M
