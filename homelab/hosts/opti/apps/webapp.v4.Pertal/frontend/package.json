{
  "name": "pertal-frontend",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Pertal (webapp v4) — SvelteKit static SPA served by the Fastify backend",
  "scripts": {
    "dev": "vite dev --port 5174",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync || echo ''"
  },
  "dependencies": {
    "@google/model-viewer": "4.1.0",
    "@lucide/svelte": "^1.41.0",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.10.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
