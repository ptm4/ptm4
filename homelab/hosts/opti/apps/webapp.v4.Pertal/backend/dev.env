# Local development settings for `npm run dev` (node --env-file-if-exists=dev.env).
# No secrets here: HL_DB_TOKEN comes from the Windows user environment on ptm, and
# HL_ARCH_INGEST_TOKEN is deliberately absent — dev runs actions in dry mode.
PORT=3100
HOMELAB_DB_URL=http://192.168.1.11:9100
PERTAL_ACTIONS=dry
