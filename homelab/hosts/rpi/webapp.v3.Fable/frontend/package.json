{
  "name": "webapp-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Pert's Pocket v3.Fable — SvelteKit static SPA served by the Fastify backend",
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview --host",
    "prepare": "svelte-kit sync || echo ''"
  },
  "dependencies": {
    "@lucide/svelte": "^1.41.0",
    "@tanstack/svelte-query": "^6.1.48",
    "bits-ui": "^2.19.0",
    "dompurify": "^3.4.15",
    "gridstack": "^13.2.0",
    "hls.js": "^1.7.2",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^22.10.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
