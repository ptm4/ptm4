# Copy to /etc/hl-arch-agent.env on each host and edit HL_ARCH_AGENT_HOST.
# This file is read by systemd's EnvironmentFile=; keep it out of the repo once it
# holds a real token (root-owned, mode 600 is fine — systemd reads it as root anyway).

# Required — must match this host's id in the architecture data (opti|rpi|noblenumbat).
# A missing/wrong value here mismatches every fragment against the curated overlay.
HL_ARCH_AGENT_HOST=

# Where to push. Default is fine unless the webapp moves.
#HL_ARCH_INGEST_URL=https://webapp.rpi.lan:8443/api/architecture/ingest

# Shared secret with the webapp's HL_ARCH_INGEST_TOKEN (see docker-compose.yml on rpi).
# Optional but recommended — without it, /ingest and this host's own /sync are unauthenticated
# on the LAN, same trade-off the dispatcher already makes with HL_DISPATCH_TOKEN.
#HL_ARCH_AGENT_TOKEN=

# Local port for GET /status and POST /sync (Force Sync). Default 8787.
#HL_ARCH_AGENT_PORT=8787

# Local hour (0-23) the nightly collection fires. Default 0 = midnight.
#HL_ARCH_RUN_HOUR=0
