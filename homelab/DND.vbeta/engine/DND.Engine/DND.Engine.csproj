<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless build of the rules engine. The SAME source files are compiled by Unity through
    DND.Engine.asmdef (this folder is the UPM package com.ptm.dnd.engine). Rules:
      - netstandard2.1 and C# 9 only: that is what Unity 6 compiles.
      - No UnityEngine, no System.Text.Json (Unity lacks it); plain BCL only.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>DND.Engine</RootNamespace>
    <AssemblyName>DND.Engine</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Runtime\**\*.cs" />
  </ItemGroup>

</Project>
