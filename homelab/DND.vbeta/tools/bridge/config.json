      ],
      "allowed_tools": [
        "Read",
        "Edit",
        "Write",
        "Glob",
        "Grep",
        "Bash(python *)",
        "Bash(python3 *)",
        "Bash(unity *)",
        "Bash(dotnet *)",
        "Bash(git status*)",
        "Bash(git diff*)",
        "Bash(git log*)",
        "Bash(ls *)",
        "Bash(cat *)",
        "Bash(git show*)",
        "Bash(git -C * status*)",
        "Bash(git -C * diff*)",
        "Bash(git -C * log*)",
        "Bash(git -C * show*)",
        "Bash(unity.exe *)",
        "Bash(certutil -hashfile *)",
        "Bash(Get-FileHash *)",
        "Bash(Get-Command *)"
