  "agents": {
    "fable": {
      "adapter": "claude",
      "exe": "C:/Users/ptm/.local/bin/claude.exe",
      "args": [
        "-p",
        "--output-format",
        "json",
        "--permission-mode",
        "acceptEdits",
        "--max-turns",
