{
  "_comment": "Astra-Fable bridge (Plan: AGENT-COLLABORATION). Dispatch is DISABLED until Peter sets enabled=true. Executable paths and argument arrays are explicit; envelope text is never interpolated into commands.",
  "enabled": true,
  "state_root": "E:/REPO/ptm4/.agent-state/dungine",
  "repo_root": "E:/REPO/ptm4",
  "unity_project": "E:/Unity/Projects/Dungine",
