      "resume_sessions": true,
      "model": null,
      "_auth": "Claude Desktop OAuth login (Max subscription). No API key. Do not add ANTHROPIC_API_KEY to this process environment."
    },
    "astra": {
      "adapter": "codex",
      "exe": "C:/Users/ptm/AppData/Local/OpenAI/Codex/bin/21cdff1aa9fa39da/codex.exe",
      "args": [
        "exec",
        "--json",
        "--skip-git-repo-check",
        "-s",
        "workspace-write",
        "-c",
        "sandbox_workspace_write.network_access=true"
      ],
      "resume_sessions": false,
      "model": null,
      "_auth": "ChatGPT login (codex login status: 'Logged in using ChatGPT'). Model and reasoning come from ~/.codex/config.toml (gpt-6-astra, xhigh); the bridge never passes -m.",
      "_sandbox": "workspace-write with localhost network allowed so `unity` can reach the Editor's Pipeline server; verified to parse 2026-09-11.",
      "exe_glob": "C:/Users/ptm/AppData/Local/OpenAI/Codex/bin/*/codex.exe",
      "_exe": "Codex self-updates into a new hashed bin dir (2026-09-11 15:30 it moved from 8e5b... to 21cd...); exe_glob picks the newest if exe is gone."
    }
  },
  "audit_ignore": [
    "homelab/arch-data-dev/",
    "homelab/agentic/generated/",
    "homelab/agentic/status/",
    ".claude/",
